[Unit]
Description=Edgehop at the login screen (type into it from the sharing computer)
Documentation=https://github.com/JawshTheDark/edgehop
After=network-online.target systemd-udev-settle.service
Wants=network-online.target

[Service]
# Borrows the signed-in user's Edgehop settings (read-only) and steps aside
# while their own Edgehop runs. Turn on in Edgehop: Settings, "Also work at
# the login screen" (or: sudo systemctl enable --now edgehop-login).
ExecStart=/usr/bin/edgehop --login-screen
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
